# Copy this file to `.env` (gitignored) and adjust as needed.

# Stage 1 (login, registration, accounts, documents, trucks) is wired to the
# real hemooltak-backend — see src/services/firebase-services.js and
# hemooltak-backend/INTEGRATION.md. Set to "true" to use it.
VITE_USE_FIREBASE_AUTH=

# Stage 2 (shipments, offers, trips, wallet) is now wired to the real
# hemooltak-backend too — see src/services/firebase-services.js. Setting
# this true also implies VITE_USE_FIREBASE_AUTH.
VITE_USE_FIREBASE=

# When true, the Firebase SDK talks to the local emulator suite
# (run from hemooltak-backend: firebase emulators:start --only
# auth,functions,firestore,storage) instead of production Firebase.
VITE_USE_EMULATORS=

# Firebase project config (src/firebase/config.js) — the same `hemooltak`
# project the backend deploys to. Override to point at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
 

# Region the hemooltak-backend Cloud Functions are deployed to. Must match
# REGION in hemooltak-backend/functions/src/constants.ts, or every call fails.
VITE_FUNCTIONS_REGION=

# Google Maps JavaScript API key (trip maps and the location picker). Put the
# real key in `.env` / Vercel only, never in this file. Restrict it in Google
# Cloud to HTTP referrers (the Vercel domain + localhost) and the Maps
# JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID from Google Cloud > Map Management (JavaScript, vector). Required by
# the map markers; leave empty to use Google's DEMO_MAP_ID during development.
VITE_GOOGLE_MAPS_MAP_ID=
