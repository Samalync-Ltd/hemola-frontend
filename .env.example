# Copy this file to `.env` (gitignored) and adjust as needed.

# Stage 1 (login, registration, accounts, documents, trucks) is wired to the
# real hemooltak-backend — see src/services/firebase-services.js and
# hemooltak-backend/INTEGRATION.md. Set to "true" to use it.
VITE_USE_FIREBASE_AUTH=true

# Stage 2 (shipments, offers, trips, wallet) is now wired to the real
# hemooltak-backend too — see src/services/firebase-services.js. Setting
# this true also implies VITE_USE_FIREBASE_AUTH.
VITE_USE_FIREBASE=true

# When true, the Firebase SDK talks to the local emulator suite
# (run from hemooltak-backend: firebase emulators:start --only
# auth,functions,firestore,storage) instead of production Firebase.
VITE_USE_EMULATORS=true

# Firebase project config (src/firebase/config.js) — the same `hemooltak`
# project the backend deploys to. Override to point at a different project.
VITE_FIREBASE_API_KEY=AIzaSyDGp022Eznp6C5KJweMfaaDsc4s10zxm0w
VITE_FIREBASE_AUTH_DOMAIN=hemooltak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hemooltak
VITE_FIREBASE_STORAGE_BUCKET=hemooltak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=230557526746
VITE_FIREBASE_APP_ID=1:230557526746:web:e46df5ab47f8928b8593e3
 