new file mode 100644
index 0000000..45656ef
--- /dev/null
+++ b/src/components/common/MapPreview.jsx
@@ -0,0 +1,88 @@
+import React, { useState } from 'react';
+import { MapPin, Flag, Truck } from 'lucide-react';
+import { TripStage } from '../../constants/enums';
+
+export const MapPreview = ({ 
+    pickupCity = '', 
+    deliveryCity = '', 
+    truckPosStage = null,
+    isInteractive = false,
+    height = 250
+}) => {
+    const [isExpanded, setIsExpanded] = useState(false);
+    
+    const getTruckPos = (stage) => {
+        switch (stage) {
+            case TripStage.ASSIGNED: return { right: '15%', top: '20%' };
+            case TripStage.PICKUP_ROUTE_EN: return { right: '25%', top: '28%' };
+            case TripStage.PICKUP_ARRIVED: return { right: '35%', top: '37%' };
+            case TripStage.LOADED: return { right: '35%', top: '37%' };
+            case TripStage.DELIVERY_ROUTE_EN: return { right: '60%', top: '60%' };
+            case TripStage.DELIVERED: return { right: '85%', top: '80%' };
+            default: return null;
+        }
+    };
+    
+    const truckPos = truckPosStage ? getTruckPos(truckPosStage) : null;
+    
+    const mapContent = (
+        <div style={{ height, backgroundColor: 'var(--color-primary)', borderRadius: 12, display: 'flex', alignItems: 'center', justifyContent: 'center', border: '1px solid var(--color-border)', position: 'relative', overflow: 'hidden', cursor: isInteractive ? 'pointer' : 'default' }} onClick={() => isInteractive && setIsExpanded(true)}>
